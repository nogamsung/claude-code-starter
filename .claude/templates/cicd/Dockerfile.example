# Dockerfile — 이 사이클의 빌드 산출물.
# 설치 위치: 프로젝트 루트 `Dockerfile` (이 파일을 복사 후 자기 앱에 맞게 교체).
#
# dev-ci.yml / release-promote.yml 는 `context: .` 로 이 Dockerfile 을 빌드합니다.
# 아래는 멀티스테이지 예시(Node) — 스택에 맞게 바꾸세요.
#
# 권장 사항:
#   - 멀티스테이지로 최종 이미지 슬림화
#   - 비루트 사용자 실행
#   - .dockerignore 로 .git, node_modules, .worktrees 등 제외

# ---- build stage ----
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- runtime stage ----
FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json ./
USER appuser
EXPOSE 3000
CMD ["node", "dist/main.js"]
